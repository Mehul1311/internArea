# Database
PG_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/internshala_clone

# Server
PORT=5000
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# JWT Secrets (Generate strong random strings in production)
JWT_SECRET=super_secret_access_token_key_123
REFRESH_SECRET=super_secret_refresh_token_key_456

# Razorpay
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=secret_placeholder

# Resend (Emails)
RESEND_API_KEY=re_123456789

# Cloudinary (File Uploads)
CLOUDINARY_CLOUD_NAME=mock_cloud
CLOUDINARY_API_KEY=mock_key
CLOUDINARY_API_SECRET=mock_secret
